---
import { TOPICS, GROUP_LABELS, type Lang, type TopicGroup } from '../data/topics';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const heading = lang === 'en' ? 'Topic guides' : 'Panduan topik';
const intro =
  lang === 'en'
    ? 'Focused pages that answer one visitor question each — visit planning, culture, food, nearby sights, and itineraries around Puri Saren Agung.'
    : 'Halaman fokus yang menjawab satu pertanyaan pengunjung: rencana kunjungan, budaya, makan, objek sekitar, dan rute dari Puri Saren Agung.';

const groupKeys = Object.keys(GROUP_LABELS) as TopicGroup[];
const groups = groupKeys
  .map((key) => ({
    key,
    label: GROUP_LABELS[key][lang],
    items: TOPICS.filter((t) => t.group === key)
  }))
  .filter((g) => g.items.length > 0);

const base = lang === 'en' ? '/en/' : '/';
---

<section id="topik" class="bg-[#efe4d3] py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-6 md:grid-cols-[.8fr_1.2fr] md:items-end">
      <div>
        <span class="eyebrow">{heading}</span>
        <h2 class="section-title mt-4">{lang === 'en' ? 'Go deeper on one question' : 'Selami satu pertanyaan'}</h2>
      </div>
      <p class="section-copy md:justify-self-end">{intro}</p>
    </div>

    {
      groups.map((g) => (
        <div class="mt-12">
          <h3 class="serif text-2xl font-bold tracking-tight text-[#1d1915]">{g.label}</h3>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((t) => {
              const c = lang === 'en' ? t.en : t.id;
              return (
                <a href={`${base}${t.slug}/`} class="card-flat rounded-[22px] p-6 no-underline transition hover:-translate-y-0.5">
                  <h4 class="serif text-xl font-bold text-[#1d1915]">{c.h1}</h4>
                  <p class="mt-2 text-sm text-[#65584c]">{c.description}</p>
                </a>
              );
            })}
          </div>
        </div>
      ))
    }
  </div>
</section>
