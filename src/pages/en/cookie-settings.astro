---
import LegalLayout from '../../layouts/LegalLayout.astro';
---
<LegalLayout
  lang="en"
  title="Cookie Settings"
  eyebrow="Site document"
  description="Manage your cookie consent for the Puri Saren Ubud guide: necessary, preference, and analytics cookies."
>
  <p>Cookies are small text files stored on your device. This page lets you set consent manually. Choices are stored locally on your device via <code>puri-saren-cookie-v1</code>.</p>

  <div class="mt-8 space-y-4">
    <div class="rounded-2xl border border-[#e2d2ae] bg-white/70 p-5">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="serif text-xl font-bold text-[#201b17]">Necessary cookies</h2>
          <p class="mt-1 text-sm text-[#554b42]">Always active. Needed to remember your consent choices and keep the site secure.</p>
        </div>
        <span class="rounded-full bg-[#c26d2f]/15 px-3 py-1 text-xs font-bold uppercase tracking-wide text-[#743625]">Always active</span>
      </div>
    </div>

    <div class="rounded-2xl border border-[#e2d2ae] bg-white/70 p-5">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="serif text-xl font-bold text-[#201b17]">Preference cookies</h2>
          <p class="mt-1 text-sm text-[#554b42]">Store non-analytics choices such as display or content-service settings. The site currently sets no preference cookies.</p>
        </div>
        <label class="switch" aria-label="Enable preference cookies">
          <input id="cookie-preferences" type="checkbox" />
          <span class="slider" aria-hidden="true"></span>
        </label>
      </div>
    </div>

    <div class="rounded-2xl border border-[#e2d2ae] bg-white/70 p-5">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="serif text-xl font-bold text-[#201b17]">Analytics cookies</h2>
          <p class="mt-1 text-sm text-[#554b42]">Google Analytics, loaded only after your consent, to understand aggregate and anonymous page usage.</p>
        </div>
        <label class="switch" aria-label="Enable analytics cookies">
          <input id="cookie-analytics" type="checkbox" />
          <span class="slider" aria-hidden="true"></span>
        </label>
      </div>
    </div>
  </div>

  <p id="cookie-status" role="status" aria-live="polite" class="mt-4 rounded-xl bg-[#c26d2f]/10 px-4 py-3 text-sm font-semibold text-[#743625]" hidden>Your cookie preferences have been saved.</p>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <button id="save-cookie" class="btn-primary text-sm" type="button">Save preferences</button>
    <button id="reject-cookie" class="btn-secondary text-sm" type="button">Reject all</button>
    <a href="/en/" class="text-sm font-bold text-[#743625] no-underline hover:text-[#a14b2b]">Back to home &rarr;</a>
  </div>

  <h2>How your choices work</h2>
  <ul>
    <li>Google Analytics is enabled only after analytics consent. Rejecting disables subsequent measurement on this page.</li>
    <li>The site tries to store your choice on your device and tells you if storage is unavailable.</li>
    <li>You can also delete cookies via your browser settings anytime.</li>
  </ul>

  <script is:inline>
    (() => {
      const STORAGE_KEY = 'puri-saren-cookie-v1';
      const GA_ID = 'G-HXM22WWPKP';
      const analyticsInput = document.getElementById('cookie-analytics');
      const preferencesInput = document.getElementById('cookie-preferences');
      const status = document.getElementById('cookie-status');

      const readPrefs = () => {
        try {
          return JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
        } catch {
          return null;
        }
      };

      const applyAnalytics = (enabled) => {
        window['ga-disable-' + GA_ID] = !enabled;
          if (!enabled || document.querySelector('script[data-ga4]')) return;
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', GA_ID, { anonymize_ip: true });
        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
        script.dataset.ga4 = 'consented';
        document.head.appendChild(script);
      };

      const writePrefs = (prefs) => {
          applyAnalytics(prefs.analytics === true);
          let saved = false;
          try { localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs)); saved = true; } catch {}
          const message = saved ? 'Your cookie preferences have been saved.' : 'Choice applies to this page. The browser could not store it for next visits.';
          if (status) { status.hidden = false; status.textContent = message; }
        };

      const initial = readPrefs();
      if (analyticsInput) analyticsInput.checked = initial?.analytics === true;
      if (preferencesInput) preferencesInput.checked = initial?.preferences === true;
      applyAnalytics(initial?.analytics === true);

      document.getElementById('save-cookie')?.addEventListener('click', () => {
        writePrefs({
          necessary: true,
          preferences: preferencesInput?.checked === true,
          analytics: analyticsInput?.checked === true,
          marketing: false,
        });
      });

      document.getElementById('reject-cookie')?.addEventListener('click', () => {
        writePrefs({ necessary: true, preferences: false, analytics: false, marketing: false });
        if (analyticsInput) analyticsInput.checked = false;
        if (preferencesInput) preferencesInput.checked = false;
      });
    })();
  </script>
</LegalLayout>
