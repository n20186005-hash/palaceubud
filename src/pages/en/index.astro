        <div class="flex flex-wrap gap-2 sm:justify-end"><a id="banner-settings" class="btn-secondary text-sm" href="/en/cookie-settings/">Settings</a><button id="banner-reject" class="btn-secondary text-sm">Reject</button><button id="banner-accept" class="btn-primary border-0 text-sm">Allow analytics</button></div>
      </div>
    <p id="banner-status" role="status" aria-live="polite"></p></div>

    <script is:inline>
      (() => {
        const STORAGE_KEY = 'puri-saren-cookie-v1';
        const GA_ID = 'G-HXM22WWPKP';
        const banner = document.getElementById('cookie-banner');

        const readPrefs = () => {
          try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null'); } catch { return null; }
        };
        const writePrefs = (prefs) => {
          applyAnalytics(prefs.analytics === true);
          let saved = false;
          try { localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs)); saved = true; } catch {}
          const message = saved ? 'Your cookie preferences have been saved.' : 'Choice applies to this page. The browser could not store it for next visits.';
          if (banner) banner.hidden = saved;
          const status = document.getElementById('banner-status');
          if (status) status.textContent = saved ? '' : message;
        };
        const applyAnalytics = (enabled) => {
          window['ga-disable-' + GA_ID] = !enabled;
          if (!enabled || document.querySelector('script[data-ga4]')) return;
          window.dataLayer = window.dataLayer || [];
          function gtag(){ window.dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', GA_ID, { anonymize_ip: true });
          const script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
          script.dataset.ga4 = 'consented';
          document.head.appendChild(script);
        };

        const initial = readPrefs();
        applyAnalytics(initial?.analytics === true);
        if (!initial && banner) banner.hidden = false;

        const reject = () => writePrefs({ necessary: true, analytics: false, preferences: false, marketing: false });
        document.getElementById('banner-reject')?.addEventListener('click', reject);
        document.getElementById('banner-accept')?.addEventListener('click', () => writePrefs({ necessary: true, analytics: true, preferences: false, marketing: false }));
      })();
    </script>
