---
import '../styles/global.css';

const title = 'Puri Saren Agung Ubud — Panduan Warisan, Sejarah & Kunjungan';
const description = 'Panduan independen Puri Saren Agung di Ubud: sejarah, arsitektur, jam kunjung, biaya, transportasi, fasilitas, etika, peta, dan tanya jawab.';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imagePath = '/images/ubud-palace-entrance.webp';
const ogImage = Astro.site ? new URL(imagePath, Astro.site).href : imagePath;

const quickFacts = [
  ['Nama lokal', 'Puri Saren Agung'],
  ['Lokasi', 'Jl. Raya Ubud No.8, Ubud, Gianyar, Bali 80571'],
  ['Jam kunjungan peta', 'Setiap hari, 07.00–17.00'],
  ['Area publik siang', 'Umumnya tanpa tiket masuk'],
  ['Waktu kunjungan', '30–60 menit untuk kompleks publik'],
  ['Karakter', 'Puri kerajaan yang masih hidup dan ruang budaya']
];

const timeline = [
  {
    label: 'Masa kerajaan Ubud',
    title: 'Kediaman raja dan pusat pemerintahan',
    body: 'Puri Saren Agung berkembang sebagai kediaman keluarga kerajaan Ubud dan pusat kekuasaan lokal. Karena itu, kompleks ini bukan sekadar bangunan tua: fungsi kediaman, adat, dan representasi kerajaan tetap penting dalam cara tempat ini dipahami.'
  },
  {
    label: 'Abad ke-20',
    title: 'Ubud tumbuh sebagai ruang pertemuan seni',
    body: 'Ubud makin dikenal sebagai pusat seni Bali. Lingkungan puri ikut menjadi bagian dari ekosistem seni pertunjukan, gamelan, upacara, dan patronase budaya yang membentuk citra Ubud hingga sekarang.'
  },
  {
    label: 'Kehidupan budaya',
    title: 'Tari dan tabuh sebagai tradisi berkelanjutan',
    body: 'Pemerintah Kabupaten Gianyar mencatat Puri Saren Ubud secara rutin menghadirkan tari dan tabuh, dengan penekanan pada pelestarian seni pertunjukan dan fungsi ritual adat.'
  },
  {
    label: 'Hari ini',
    title: 'Sebagian dibuka, sebagian tetap privat',
    body: 'Sebagian area dapat dikunjungi publik, sementara bagian lain tetap terkait dengan kehidupan keluarga kerajaan dan kegiatan adat. Batas akses dapat berubah ketika ada upacara atau kegiatan khusus.'
  }
];

const architecture = [
  ['01', 'Gerbang dan ambang', 'Gerbang bukan hanya elemen dekoratif. Dalam arsitektur Bali, ambang menandai perpindahan dari ruang luar menuju ruang yang memiliki tata, fungsi, dan tingkat kesakralan berbeda. Perhatikan susunan bata, batu paras, dan ukiran pada pintu masuk.'],
  ['02', 'Bale dan halaman', 'Paviliun terbuka atau bale mengandalkan hubungan antara atap, tiang, halaman, dan sirkulasi udara. Pengalaman ruang terbentuk dari urutan halaman, bukan dari satu bangunan tertutup seperti istana Eropa.'],
  ['03', 'Bata merah dan batu paras', 'Warna terakota, batu abu-abu, ukiran floral, serta detail figuratif memberi ritme pada dinding dan gerbang. Material tampak dekoratif sekaligus menunjukkan keterampilan tukang tradisional Bali.'],
  ['04', 'Ruang yang tetap berfungsi', 'Jangan membaca seluruh kompleks sebagai objek pameran. Area tertentu masih berhubungan dengan kediaman, upacara, persiapan pertunjukan, dan aktivitas adat; rambu pembatas perlu dipatuhi.']
];

const facilities = [
  ['Toilet / WC', 'Ketersediaan di area kunjungan publik dapat terbatas. Gunakan fasilitas umum di pusat Ubud sebelum masuk bila perlu.', 'caution'],
  ['Parkir', 'Jangan mengandalkan parkir tepat di gerbang. Pusat Ubud padat; cari area parkir umum resmi dan ikuti petunjuk setempat.', 'caution'],
  ['Akses kursi roda', 'Permukaan batu, ambang, dan anak tangga membuat rute tidak sepenuhnya bebas hambatan. Pendamping dapat membantu.', 'caution'],
  ['Makanan & minuman', 'Banyak pilihan tipe warung, rumah makan, kedai kopi, dan toko kebutuhan harian di pusat Ubud; konsumsi dilakukan di luar area yang dibatasi.', 'ok'],
  ['Akomodasi', 'Pusat Ubud memiliki tipe pondok wisata, rumah tamu, hotel butik, dan vila. Pilih berdasarkan akses pejalan kaki dan kebutuhan mobilitas, bukan peringkat komersial.', 'ok'],
  ['Belanja kebutuhan', 'Pasar tradisional, minimarket, dan swalayan tersedia di kawasan Ubud. Periksa jam buka masing-masing fasilitas saat tiba.', 'ok'],
  ['BBM & pengisian kendaraan listrik', 'SPBU dan titik pengisian kendaraan listrik tersedia di wilayah Ubud/Gianyar yang lebih luas; lokasi dan status operasional perlu dicek sebelum berangkat.', 'caution'],
  ['Cuaca & teduh', 'Sebagian kunjungan berada di ruang terbuka. Siapkan pelindung matahari atau hujan; permukaan dapat licin setelah hujan.', 'caution']
];

const faq = [
  ['Apakah masuk Puri Saren Agung gratis?', 'Akses ke area publik untuk kunjungan siang umumnya tidak dipungut tiket masuk. Pertunjukan budaya malam merupakan kegiatan terpisah dan dapat memerlukan tiket. Kebijakan dapat berubah, jadi periksa informasi di lokasi pada hari kunjungan.'],
  ['Berapa lama waktu yang dibutuhkan?', 'Sekitar 30–60 menit cukup untuk mengamati area publik dengan tenang. Jika digabung dengan kawasan budaya pusat Ubud, siapkan sekitar 2–3 jam.'],
  ['Apakah puri masih ditempati keluarga kerajaan?', 'Ya, sumber resmi pariwisata Indonesia menyebut sebagian kompleks masih digunakan keluarga kerajaan. Karena itu tidak semua bagian terbuka untuk umum.'],
  ['Apakah ada pertunjukan tari setiap malam?', 'Pertunjukan tari tradisional sering diselenggarakan pada malam hari, tetapi jadwal, jenis pertunjukan, lokasi pelataran, dan tiket dapat berubah. Verifikasi jadwal pada hari kunjungan.'],
  ['Apa pakaian yang tepat?', 'Gunakan pakaian sopan dan nyaman. Jika ada upacara atau area yang meminta ketentuan khusus, ikuti arahan petugas dan masyarakat setempat. Jangan memindahkan sesajen.'],
  ['Apakah mudah dikunjungi dengan kursi roda?', 'Tidak sepenuhnya. Beberapa permukaan tidak rata, terdapat ambang dan anak tangga, dan ruang sirkulasi dapat sempit. Pengunjung dengan kebutuhan mobilitas sebaiknya datang dengan pendamping dan menilai rute di tempat.'],
  ['Apakah tersedia parkir di depan puri?', 'Area pusat Ubud sangat padat dan parkir tepat di gerbang tidak dapat dijamin. Lebih aman merencanakan parkir umum resmi, turun di titik aman, atau berjalan dari akomodasi pusat kota.'],
  ['Kapan waktu terbaik datang?', 'Pagi setelah jam buka biasanya lebih nyaman untuk mengamati detail arsitektur dan mengurangi paparan panas. Sore memberi suasana berbeda, tetapi jangan menyamakan jam kunjungan siang dengan jadwal pertunjukan malam.']
];

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  name: 'Puri Saren Agung (Ubud Palace)',
  alternateName: 'Istana Ubud',
  description,
  ...(canonical ? { url: canonical } : {}),
  ...(Astro.site ? { image: new URL(imagePath, Astro.site).href } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Jl. Raya Ubud No.8',
    addressLocality: 'Ubud',
    addressRegion: 'Bali',
    postalCode: '80571',
    addressCountry: 'ID'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -8.506222586122313,
    longitude: 115.25940537693005
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '07:00',
    closes: '17:00'
  }],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.3',
    reviewCount: '20020',
    bestRating: '5'
  },
  priceRange: 'Area publik siang umumnya gratis; pertunjukan budaya dapat berbayar',
  isAccessibleForFree: true
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer }
  }))
};
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d1915" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </head>
  <body>
    <a href="#konten" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-2">Lewati ke konten utama</a>

    <header class="absolute inset-x-0 top-0 z-30 border-b border-white/15 text-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-5 py-4 lg:px-8">
        <a href="#atas" aria-label="Puri Saren Ubud — kembali ke atas" class="flex items-center gap-3 no-underline">
          <img src="/favicon.svg" width="44" height="44" alt="" class="h-11 w-11 rounded-xl" />
          <span class="leading-tight">
            <strong class="serif block text-lg">Puri Saren Ubud</strong>
            <span class="text-[.67rem] font-bold tracking-[.16em] text-white/70">PANDUAN WARISAN</span>
          </span>
        </a>
        <nav aria-label="Navigasi utama" class="hidden items-center gap-6 text-sm font-semibold lg:flex">
          <a href="#sejarah" class="no-underline hover:text-[#e7c88f]">Sejarah</a>
          <a href="#kunjungan" class="no-underline hover:text-[#e7c88f]">Kunjungan</a>
          <a href="#transportasi" class="no-underline hover:text-[#e7c88f]">Transportasi</a>
          <a href="#fasilitas" class="no-underline hover:text-[#e7c88f]">Fasilitas</a>
          <a href="#sekitar" class="no-underline hover:text-[#e7c88f]">Sekitar</a>
          <a href="#faq" class="no-underline hover:text-[#e7c88f]">Tanya jawab</a>
        </nav>
        <a href="#peta" class="btn-secondary text-sm text-white">Lihat peta</a>
      </div>
    </header>

    <main id="konten">
      <section id="atas" class="relative min-h-[880px] overflow-hidden bg-[#181411] text-white lg:min-h-[760px]">
        <img src="/images/ubud-palace-entrance.webp" alt="Gerbang dan arsitektur Puri Saren Agung di pusat Ubud" width="1800" height="1200" fetchPriority="high" class="absolute inset-0 h-full w-full object-cover" />
        <div class="hero-overlay hero-grid absolute inset-0"></div>
        <div class="relative mx-auto flex min-h-[880px] max-w-7xl items-end px-5 pb-14 pt-36 lg:min-h-[760px] lg:px-8 lg:pb-16">
          <div class="grid w-full gap-10 lg:grid-cols-[1.25fr_.75fr] lg:items-end">
            <div class="max-w-4xl">
              <div class="mb-6 flex flex-wrap gap-2">
                <span class="tag !bg-white/12 !text-[#f2dfbb]">Ubud · Kabupaten Gianyar</span>
                <span class="tag !bg-white/12 !text-[#f2dfbb]">Puri kerajaan & ruang budaya</span>
              </div>
              <p class="mb-4 text-sm font-bold uppercase tracking-[.2em] text-[#e7c88f]">Panduan independen · nonkomersial</p>
              <h1 class="serif max-w-4xl text-[clamp(3.8rem,9vw,8rem)] leading-[.82] tracking-[-.055em]">Puri Saren<br /><span class="text-[#e7c88f]">Agung.</span></h1>
              <p class="mt-7 max-w-2xl text-lg leading-8 text-white/82 lg:text-xl">Di jantung Ubud, istana ini masih dibaca sebagai ruang hidup: kediaman kerajaan, panggung seni, halaman upacara, dan arsip arsitektur Bali yang dapat dipahami melalui detail, tata ruang, dan etika berkunjung.</p>
              <div class="mt-8 flex flex-wrap gap-3">
                <a class="btn-primary" href="#kunjungan">Rencanakan kunjungan <span aria-hidden="true">↓</span></a>
                <a class="btn-secondary" href="https://maps.app.goo.gl/N4MhZtoyuNfEbo4A8" target="_blank" rel="noopener noreferrer">Buka lokasi di Google Maps <span aria-hidden="true">↗</span></a>
              </div>
              <p class="mt-5 text-xs text-white/55">Foto: Niklas Weiss / Unsplash · berkas disajikan secara lokal.</p>
            </div>
            <aside class="glass rounded-[28px] p-6 lg:p-7" aria-label="Ringkasan kunjungan">
              <div class="flex items-start justify-between gap-4 border-b border-white/15 pb-5">
                <div>
                  <p class="text-xs font-bold uppercase tracking-[.16em] text-white/55">Ringkas</p>
                  <p class="serif mt-1 text-2xl">Sebelum masuk</p>
                </div>
                <div class="rounded-full border border-[#e7c88f]/35 px-3 py-1 text-sm font-bold text-[#e7c88f]">4,3 / 5</div>
              </div>
              <dl class="mt-5 grid gap-5 text-sm sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
                <div><dt class="text-white/50">Jam peta</dt><dd class="mt-1 font-bold">07.00–17.00</dd></div>
                <div><dt class="text-white/50">Area siang</dt><dd class="mt-1 font-bold">Umumnya gratis</dd></div>
                <div><dt class="text-white/50">Durasi</dt><dd class="mt-1 font-bold">30–60 menit</dd></div>
                <div><dt class="text-white/50">Pakaian</dt><dd class="mt-1 font-bold">Sopan & nyaman</dd></div>
              </dl>
              <p class="mt-6 rounded-2xl bg-white/8 p-4 text-sm leading-6 text-white/70"><strong class="text-white">Penting:</strong> jam kunjungan siang dan jadwal pertunjukan malam adalah dua hal berbeda. Kegiatan adat dapat mengubah akses tanpa pemberitahuan jauh hari.</p>
            </aside>
          </div>
        </div>
      </section>

      <section class="pattern-border bg-[#fffaf1] py-16 lg:py-20" aria-labelledby="fakta-title">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <div class="mb-9 grid gap-5 md:grid-cols-[.8fr_1.2fr] md:items-end">
            <div><span class="eyebrow">Orientasi</span><h2 id="fakta-title" class="serif mt-3 text-4xl font-bold tracking-tight">Enam fakta untuk membaca tempat</h2></div>
            <p class="section-copy md:justify-self-end">Data operasional dapat berubah; halaman ini membedakan fakta lokasi yang dapat diperbarui dari konteks sejarah dan budaya yang lebih stabil.</p>
          </div>
          <dl class="info-grid grid overflow-hidden rounded-[26px] border border-black/10 bg-white sm:grid-cols-2 lg:grid-cols-3">
            {quickFacts.map(([term, detail]) => <div class="min-h-32 border-b border-black/10 p-6 sm:border-r lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-last-child(-n+3)]:border-b-0"><dt>{term}</dt><dd>{detail}</dd></div>)}
          </dl>
        </div>
      </section>

      <section id="sejarah" class="bg-[#1d1915] py-20 text-[#f6f0e6] lg:py-28">
        <div class="mx-auto grid max-w-7xl gap-14 px-5 lg:grid-cols-[.9fr_1.1fr] lg:px-8">
          <div class="lg:sticky lg:top-8 lg:self-start">
            <span class="eyebrow !text-[#d7ad67]">Sejarah & konteks</span>
            <h2 class="section-title mt-5">Bukan reruntuhan. <span class="text-[#d7ad67]">Puri yang hidup.</span></h2>
            <p class="mt-7 max-w-xl text-lg leading-8 text-white/68">Sumber pariwisata resmi Indonesia menyebut Istana Ubud atau Puri Saren Agung sebagai kediaman resmi keluarga kerajaan Ubud. Sebagian areanya dibuka untuk umum, sementara fungsi kediaman dan budaya tetap berjalan.</p>
            <blockquote class="mt-8 border-l-2 border-[#d7ad67] pl-5 text-white/75">Cara paling tepat melihat Puri Saren Agung bukan hanya mencari “bangunan tertua”, tetapi memahami hubungan antara kekuasaan lokal, tata ruang Bali, pertunjukan, dan kehidupan adat di pusat Ubud.</blockquote>
          </div>
          <div class="timeline space-y-10">
            {timeline.map((item) => <article class="timeline-item"><p class="text-xs font-bold uppercase tracking-[.16em] text-[#d7ad67]">{item.label}</p><h3 class="serif mt-1 text-2xl font-bold">{item.title}</h3><p class="mt-3 max-w-2xl text-white/62">{item.body}</p></article>)}
            <div class="ml-12 rounded-2xl border border-white/12 bg-white/5 p-5 text-sm leading-6 text-white/58"><strong class="text-white">Catatan metodologi:</strong> kami menghindari tanggal pembangunan tunggal yang sering berbeda antar-sumber populer. Untuk konteks publik, sumber pemerintah dan pariwisata resmi diberi prioritas.</div>
          </div>
        </div>
      </section>

      <section class="bg-[#efe4d3] py-20 lg:py-28" aria-labelledby="arsitektur-title">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <div class="grid gap-6 lg:grid-cols-[1.05fr_.95fr] lg:items-end">
            <div><span class="eyebrow">Cara membaca arsitektur</span><h2 id="arsitektur-title" class="section-title mt-4">Lihat urutan ruang, bukan hanya ukiran.</h2></div>
            <p class="section-copy lg:justify-self-end">Arsitektur puri Bali dibentuk oleh halaman, gerbang, bale, ambang, material, dan fungsi. Bagian yang terlihat publik hanya satu lapisan dari kompleks yang lebih luas.</p>
          </div>
          <div class="mt-12 grid gap-5 md:grid-cols-2">
            {architecture.map(([num, name, body]) => <article class="card-flat rounded-[24px] p-7"><div class="arch-number">{num}</div><h3 class="serif mt-5 text-2xl font-bold">{name}</h3><p class="mt-3 text-[#65584c]">{body}</p></article>)}
          </div>
          <div class="mt-12 grid gap-5 lg:grid-cols-[1.2fr_.8fr]">
            <figure class="overflow-hidden rounded-[28px] bg-[#1d1915]">
              <img src="/images/ubud-palace-pavilion.webp" alt="Paviliun dan detail arsitektur tradisional Bali di kawasan Puri Saren Agung" width="1800" height="1200" loading="lazy" class="h-full min-h-[420px] w-full object-cover" />
            </figure>
            <div class="rounded-[28px] bg-[#9f4f35] p-8 text-white lg:p-10">
              <p class="text-xs font-bold uppercase tracking-[.16em] text-white/60">Etika visual</p>
              <h3 class="serif mt-3 text-3xl font-bold">Foto dengan rasa hormat.</h3>
              <p class="mt-5 text-white/78">Jangan memanjat gerbang, duduk di struktur ritual, menghalangi prosesi, atau memindahkan sesajen demi komposisi foto. Saat ada upacara atau pertunjukan, ikuti pembatas dan arahan di tempat.</p>
              <p class="mt-7 text-xs text-white/55">Foto: Ameya Khanzode / Unsplash · berkas disajikan secara lokal.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="kunjungan" class="bg-[#fffaf1] py-20 lg:py-28">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <span class="eyebrow">Rencana kunjungan</span>
          <div class="mt-4 grid gap-10 lg:grid-cols-[1fr_1fr]">
            <div>
              <h2 class="section-title">Datang dengan ekspektasi yang tepat.</h2>
              <p class="section-copy mt-6">Puri Saren Agung cocok sebagai kunjungan singkat yang diperdalam lewat observasi. Nilainya bukan pada luas area publik, melainkan pada konteks kerajaan, arsitektur, dan budaya pertunjukan.</p>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <article class="card rounded-[22px] p-6"><span class="tag">Jam</span><h3 class="serif mt-4 text-2xl font-bold">07.00–17.00</h3><p class="mt-2 text-sm text-[#65584c]">Jam yang ditampilkan Google Maps saat panduan disusun. Akses dapat menyesuaikan kegiatan adat.</p></article>
              <article class="card rounded-[22px] p-6"><span class="tag">Biaya</span><h3 class="serif mt-4 text-2xl font-bold">Siang: umumnya gratis</h3><p class="mt-2 text-sm text-[#65584c]">Pertunjukan malam berbayar dan terpisah; harga tidak kami bekukan karena dapat berubah.</p></article>
              <article class="card rounded-[22px] p-6"><span class="tag">Waktu terbaik</span><h3 class="serif mt-4 text-2xl font-bold">Pagi setelah buka</h3><p class="mt-2 text-sm text-[#65584c]">Lebih nyaman untuk mengamati detail dan mengurangi paparan panas. Pusat Ubud semakin padat menjelang siang.</p></article>
              <article class="card rounded-[22px] p-6"><span class="tag">Durasi</span><h3 class="serif mt-4 text-2xl font-bold">30–60 menit</h3><p class="mt-2 text-sm text-[#65584c]">Tambahkan 2–3 jam jika berjalan di klaster budaya pusat Ubud.</p></article>
            </div>
          </div>

          <div class="mt-12 grid gap-5 lg:grid-cols-3">
            <article class="rounded-[24px] border border-black/10 bg-[#f2e7d4] p-7"><p class="text-xs font-bold uppercase tracking-[.14em] text-[#743625]">Sebelum masuk</p><h3 class="serif mt-2 text-2xl font-bold">Periksa kegiatan hari itu</h3><p class="mt-3 text-[#65584c]">Jika ada upacara, persiapan pertunjukan, atau acara keluarga, beberapa jalur dapat ditutup sementara. Hormati keputusan akses di lapangan.</p></article>
